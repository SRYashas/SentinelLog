{
  "name": "sentinellog",
  "version": "1.0.0",
  "description": "SentinelLog — Offline Windows Process & Console Activity Monitor",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix server install && npm --prefix collector install && npm --prefix dashboard install && npm --prefix desktop install",
    "build": "npm --prefix dashboard run build",
    "start": "npm --prefix server start",
    "collector": "npm --prefix collector start",
    "app": "npm --prefix desktop start",
    "exe": "npm --prefix desktop run dist",
    "build-all": "npm --prefix desktop run dist",
    "install-service": "npm --prefix collector run install-service",
    "uninstall-service": "npm --prefix collector run uninstall-service"
  },
  "keywords": [
    "windows",
    "monitoring",
    "sysmon",
    "powershell",
    "offline",
    "security"
  ],
  "author": "",
  "license": "MIT"
}
